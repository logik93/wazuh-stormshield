<group name="stormshield,sns,">
  <rule id="110500" level="0">
    <decoded_as>stormshield-sns</decoded_as>
    <description>Stormshield SNS event</description>
  </rule>

  <rule id="110501" level="4">
    <if_sid>110500</if_sid>
    <field name="sns.logtype" type="pcre2">^(?:filter|connection|web|ssl)$</field>
    <field name="sns.action" type="pcre2">(?i)^(?:block|deny|drop|reject)$</field>
    <description>Stormshield SNS: traffic blocked by policy</description>
    <group>firewall_drop,</group>
  </rule>

  <rule id="110502" level="6">
    <if_sid>110500</if_sid>
    <field name="sns.logtype" type="pcre2">^alarm$</field>
    <description>Stormshield SNS: alarm $(sns.alarm_id) ($(sns.message))</description>
  </rule>

  <rule id="110503" level="9">
    <if_sid>110502</if_sid>
    <field name="sns.alarm_class" type="pcre2" negate="yes">(?i)^system$</field>
    <field name="sns.action" type="pcre2">(?i)^(?:block|deny|drop|reject)$</field>
    <description>Stormshield SNS: blocking alarm $(sns.alarm_id) ($(sns.message))</description>
  </rule>

  <rule id="110504" level="6">
    <if_sid>110500</if_sid>
    <field name="sns.logtype" type="pcre2">^auth$</field>
    <field name="sns.error" type="pcre2">^0*[1-9][0-9]*$</field>
    <description>Stormshield SNS: authentication failure</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="110505" level="6">
    <if_sid>110500</if_sid>
    <field name="sns.logtype" type="pcre2">^auth$</field>
    <regex type="pcre2" negate="yes">^(?:[^\s=]+=(?:"(?:\\.|[^"\\])*"|[^"\s]*)\s+)*?error=(?:"0+"|0+)(?=\s|$)</regex>
    <field name="sns.message" type="pcre2">(?i)^authentication failed\b</field>
    <description>Stormshield SNS: authentication failure reported in message</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="110506" level="7">
    <if_sid>110500</if_sid>
    <field name="sns.logtype" type="pcre2">^(?:vpn|xvpn)$</field>
    <field name="sns.message" type="pcre2">(?i)\b(?:failed|failure|no proposal chosen|timed out|denied)\b</field>
    <description>Stormshield SNS: VPN failure reported by appliance</description>
    <group>vpn,</group>
  </rule>

  <rule id="110507" level="5">
    <if_sid>110500</if_sid>
    <field name="sns.logtype" type="pcre2">^server$</field>
    <field name="sns.error" type="pcre2">^0+$</field>
    <field name="sns.message" type="pcre2">(?i)^CONFIG\s+(?:\S+\s+)?(?:ADD|SET|DELETE|ACTIVATE|IMPORT)\b</field>
    <description>Stormshield SNS: configuration change command in admin audit</description>
    <group>configuration_changed,</group>
  </rule>

  <rule id="110508" level="10" frequency="5" timeframe="120">
    <if_matched_group>authentication_failed</if_matched_group>
    <if_sid>110504,110505</if_sid>
    <field name="sns.device" type="pcre2">\S</field>
    <field name="sns.logtype" type="pcre2">^auth$</field>
    <same_field>sns.device</same_field>
    <same_srcip />
    <description>Stormshield SNS: repeated authentication failures from the same source</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="110509" level="8" frequency="10" timeframe="60">
    <if_matched_sid>110501</if_matched_sid>
    <if_sid>110501</if_sid>
    <field name="sns.device" type="pcre2">\S</field>
    <same_field>sns.device</same_field>
    <same_srcip />
    <description>Stormshield SNS: repeated firewall blocks from the same source</description>
  </rule>
</group>
