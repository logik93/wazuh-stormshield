<decoder name="qnap-qulog">
  <type>syslog</type>
  <program_name type="pcre2">(?i)^(?:qnap-qulog|qnap|qts|quts|qulogd?|qulogcenter)$</program_name>
</decoder>

<decoder name="qnap-qulog">
  <type>syslog</type>
  <prematch type="pcre2">^\s*\[QuLog Center\](?:\s|$)</prematch>
</decoder>

<decoder name="qnap-qulog">
  <parent>qnap-qulog</parent>
  <regex type="pcre2">^\s*(\S.*?)\s*$</regex>
  <order>qnap.message</order>
</decoder>

<decoder name="qnap-qulog">
  <parent>qnap-qulog</parent>
  <regex type="pcre2">^\s*(?:\[QuLog Center\]\s+(?:Notification:\s+)?)?\[([^\]]+)\]</regex>
  <order>qnap.component</order>
</decoder>

<decoder name="qnap-qulog">
  <parent>qnap-qulog</parent>
  <regex type="pcre2">(?i)\b(?:source\s+ip(?:\s+address)?\s*[:=]\s*|from\s+(?:ip(?:\s+address)?\s+)?)[\["']?(\d{1,3}(?:\.\d{1,3}){3}|[\da-f]*:[\da-f:.]+)(?=$|[\s\]"',;]|\.(?:\s|$))</regex>
  <order>srcip</order>
</decoder>

<decoder name="qnap-qulog">
  <parent>qnap-qulog</parent>
  <regex type="pcre2">(?i)\b(?:user(?:name)?\s*[:=]\s*|user\s+\[)(?|"([^"]+)"|'([^']+)'|\[?([^\s\]",;']+))</regex>
  <order>dstuser</order>
</decoder>

<decoder name="qnap-qulog">
  <parent>qnap-qulog</parent>
  <regex type="pcre2">(?i)^\s*conn log:\s*Users:\s*(.+?),\s*Source IP:</regex>
  <order>dstuser</order>
</decoder>

<decoder name="qnap-qulog">
  <parent>qnap-qulog</parent>
  <regex type="pcre2">(?i)^\s*conn log:.*?,\s*Computer name:\s*(.+?),\s*Connection type:\s*(.+?),\s*Accessed resources:\s*(.*),\s*Action:\s*([a-z][a-z0-9 _-]*?)\s*$</regex>
  <order>qnap.client_host,qnap.connection_type,qnap.resource,qnap.action</order>
</decoder>
