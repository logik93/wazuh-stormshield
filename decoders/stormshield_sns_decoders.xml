<!-- Match complete WELF tokens so keys inside quoted values are ignored. -->
<var name="welf_prefix">^(?:[^\s=]+=(?:"(?:\\.|[^"\\])*"|[^"\s]*)\s+)*?</var>
<var name="welf_value">(?|"((?:\\.|[^"\\])+)"|([^"\s]+))(?=\s|\z)</var>

<decoder name="stormshield-sns">
  <type>syslog</type>
  <prematch type="pcre2">^id=(?:"firewall"|firewall)\s+</prematch>
</decoder>

<decoder name="stormshield-sns">
  <parent>stormshield-sns</parent>
  <regex type="pcre2">(?x)$welf_prefix logtype=$welf_value</regex>
  <order>sns.logtype</order>
</decoder>

<decoder name="stormshield-sns">
  <parent>stormshield-sns</parent>
  <regex type="pcre2">(?x)$welf_prefix fw=$welf_value</regex>
  <order>sns.device</order>
</decoder>

<decoder name="stormshield-sns">
