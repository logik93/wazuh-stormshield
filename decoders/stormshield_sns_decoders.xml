<decoder name="stormshield-sns">
  <parent>stormshield-sns</parent>
  <regex type="pcre2">(?x)$welf_prefix src=(?|"(\d{1,3}(?:\.\d{1,3}){3}|[\da-fA-F]*:[\da-fA-F:.]+)"|(\d{1,3}(?:\.\d{1,3}){3}|[\da-fA-F]*:[\da-fA-F:.]+))(?=\s|\z)</regex>
  <order>srcip</order>
</decoder>

<decoder name="stormshield-sns">
  <parent>stormshield-sns</parent>
  <regex type="pcre2">(?x)$welf_prefix dst=(?|"(\d{1,3}(?:\.\d{1,3}){3}|[\da-fA-F]*:[\da-fA-F:.]+)"|(\d{1,3}(?:\.\d{1,3}){3}|[\da-fA-F]*:[\da-fA-F:.]+))(?=\s|\z)</regex>
  <order>dstip</order>
</decoder>

<decoder name="stormshield-sns">
